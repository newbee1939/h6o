---
import { getCollection } from 'astro:content';

interface Props {
  lang: 'ja' | 'en';
}

const { lang } = Astro.props;

// id は "<slug>.<lang>"。同じ lang の記事だけを日付降順で並べる。
const posts = (await getCollection('posts', ({ data }) => data.lang === lang)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// BASE_URL は末尾スラッシュの有無が設定次第なので、揃えてから連結する。
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<ul>
  {
    posts.map((post) => {
      const date = post.data.date.toISOString().slice(0, 10);
      return (
        <li>
          <time datetime={date}>{date}</time>
          <br />
          <a href={`${base}/${lang}/${post.id.split('.')[0]}/`}>{post.data.title}</a>
        </li>
      );
    })
  }
</ul>
