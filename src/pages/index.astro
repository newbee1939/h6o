---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

// id は "<slug>.<lang>"。当面は日本語だけ並べる（言語切替は P3-2 / P3-3）。
const posts = (await getCollection('posts', ({ data }) => data.lang === 'ja')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// BASE_URL は末尾スラッシュの有無が設定次第なので、揃えてから連結する。
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="h6o" description="技術と働き方について考えたことを書くブログ" lang="ja">
  <h1>h6o</h1>
  <ul>
    {
      posts.map((post) => {
        const date = post.data.date.toISOString().slice(0, 10);
        return (
          <li>
            <time datetime={date}>{date}</time>
            <br />
            <a href={`${base}/ja/${post.id.split('.')[0]}/`}>
              {post.data.title}
            </a>
            <p>{post.data.description}</p>
          </li>
        );
      })
    }
  </ul>
</Base>
